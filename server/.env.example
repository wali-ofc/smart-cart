# SmartCart server env template — copy to `.env` and fill in.
# NEVER commit real credentials. .env is gitignored; .env.example is safe to share.
# NOTE: server.js loads this file via an explicit path (server/.env), so it
# works no matter what directory the process is started from (local dev, Hostinger, Render).

# MongoDB Atlas (production / Hostinger — spec ch.6)
# Replace <dbUser>, <dbPassword>, <cluster>, <appName> with your Atlas cluster values.
# Create a free M0 cluster at cloud.mongodb.com → Database Access → add user → Network Access → 0.0.0.0/0
MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@<cluster>.mongodb.net/FYP?retryWrites=true&w=majority&appName=<appName>

# Local MongoDB (dev only) — database name: FYP
# MONGODB_URI=mongodb://localhost:27017/FYP

# JWT — use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change_me_32_random_hex_chars
JWT_EXPIRE=7d

# Ollama (chatbot, spec 4.2.5) — not available on shared hosting; endpoint returns 503, which is handled
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mystore-bot:latest
# Fallback model if the primary fails/times out. Must actually be lighter than
# OLLAMA_MODEL — both shipped models are ~1B, so the "fallback" costs the same.
OLLAMA_FALLBACK_MODEL=gemma3:1b
# How long Ollama keeps a model in RAM after a request. Ollama's own default is
# 5m; a reload costs ~40-50s here and used to push requests past the timeout.
OLLAMA_KEEP_ALIVE=30m
# Per-model generation budget (ms). The local models are slow and variable on a
# full customer-context prompt; 120s clears the observed worst case.
OLLAMA_TIMEOUT_MS=120000

# Chat rate limit (per user per day)
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_WINDOW_MS=86400000

# Server (dev machine uses 5050 — 5000 is excluded by Hyper-V port reservation here)
PORT=5050
NODE_ENV=development

# Production CORS origin override (Hostinger temporary domain is the default; set this when using a custom domain)
CLIENT_URL=https://olive-jay-713205.hostingersite.com

# Demo seller account created by `npm run seed` (Phase 4)
DEMO_SELLER_EMAIL=seller@smartcart.local
DEMO_SELLER_PASSWORD=seller123